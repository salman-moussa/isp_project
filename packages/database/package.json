{
  "name": "@isp/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "tsx --conditions=development scripts/test-live-finance-audit-upgrade.ts && node scripts/test-live-postgres.mjs && node scripts/test-live-finance.mjs && tsx --conditions=development scripts/test-live-finance-outbox.ts",
    "test:finance-integration": "node scripts/test-live-finance.mjs",
    "test:finance-outbox-integration": "tsx --conditions=development scripts/test-live-finance-outbox.ts",
    "db:check": "node scripts/check-schema.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:adopt-legacy": "node scripts/adopt-legacy-baseline.mjs"
  },
  "dependencies": {
    "@isp/contracts": "0.1.0",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
