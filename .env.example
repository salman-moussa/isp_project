# Copy to .env for local development only. Replace every change-me value.
# Production uses a secret manager/runtime injection, not this file.
COMPOSE_PROJECT_NAME=orvex-isp-local
APP_ENV=local
APP_URL=http://localhost:3000
PLATFORM_CONTROL_URL=http://localhost:3001
TENANT_BASE_DOMAIN=isp.localhost
APP_TIMEZONE=Asia/Beirut
APP_LOCALES=en,ar
LOG_LEVEL=debug
LOG_FORMAT=json

# Reviewed local image versions. Production images must be digest-pinned and scanned.
POSTGRES_IMAGE=postgres:18.4-alpine
REDIS_IMAGE=redis:8.8.0-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MAILPIT_IMAGE=axllent/mailpit:v1.30.0

POSTGRES_USER=isp
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_DB=isp_control
POSTGRES_HOST_PORT=5432
ORVEX_MIGRATOR_DB_PASSWORD=change-me-local-orvex-migrator
ORVEX_RUNTIME_DB_PASSWORD=change-me-local-orvex-runtime
ORVEX_FINANCE_AUDIT_RELAY_DB_PASSWORD=change-me-local-orvex-finance-audit-relay
DATABASE_CONTROL_URL=postgresql://orvex_runtime:change-me-local-orvex-runtime@127.0.0.1:5432/isp_control
DATABASE_TENANT_ADMIN_URL=postgresql://isp:change-me-local-postgres@127.0.0.1:5432/postgres
DATABASE_BOOTSTRAP_URL=postgresql://isp:change-me-local-postgres@127.0.0.1:5432/isp_control
ORVEX_DATABASE_NAME=isp_control
ORVEX_LEGACY_DB_OWNER=isp
CONTROL_DATABASE_URL=postgresql://orvex_runtime:change-me-local-orvex-runtime@127.0.0.1:5432/isp_control
TENANT_DATABASE_URL=postgresql://orvex_runtime:change-me-local-orvex-runtime@127.0.0.1:5432/isp_tenant_template
CONTROL_FINANCE_AUDIT_RELAY_DATABASE_URL=postgresql://orvex_finance_audit_relay:change-me-local-orvex-finance-audit-relay@127.0.0.1:5432/isp_control
TENANT_FINANCE_AUDIT_RELAY_DATABASE_URL=postgresql://orvex_finance_audit_relay:change-me-local-orvex-finance-audit-relay@127.0.0.1:5432/isp_tenant_template
# Container-internal relay endpoints use the Compose service hostname, never host loopback.
FINANCE_AUDIT_CONTROL_DATABASE_URL=postgresql://orvex_finance_audit_relay:change-me-local-orvex-finance-audit-relay@postgres:5432/isp_control
FINANCE_AUDIT_TENANTS_JSON=[{"tenantId":"00000000-0000-4000-8000-000000000001","databaseUrl":"postgresql://orvex_finance_audit_relay:change-me-local-orvex-finance-audit-relay@postgres:5432/isp_tenant_template"}]
FINANCE_AUDIT_HEALTH_HOST_PORT=9464
FINANCE_AUDIT_BATCH_SIZE=100
FINANCE_AUDIT_POLL_INTERVAL_MS=1000
FINANCE_AUDIT_READINESS_MAX_BACKLOG_COUNT=500
FINANCE_AUDIT_READINESS_MAX_BACKLOG_AGE_MS=120000
DATABASE_RUNTIME_URL=postgresql://orvex_runtime:change-me-local-orvex-runtime@127.0.0.1:5432/isp_control
DATABASE_MIGRATION_URL=postgresql://orvex_migrator:change-me-local-orvex-migrator@127.0.0.1:5432/isp_control
CONTROL_DATABASE_MIGRATION_URL=postgresql://orvex_migrator:change-me-local-orvex-migrator@127.0.0.1:5432/isp_control
TENANT_DATABASE_MIGRATION_URL=postgresql://orvex_migrator:change-me-local-orvex-migrator@127.0.0.1:5432/isp_tenant_template

REDIS_PASSWORD=change-me-local-redis
REDIS_HOST_PORT=6379
REDIS_URL=redis://:change-me-local-redis@127.0.0.1:6379/0

MINIO_ROOT_USER=orvex-local-admin
MINIO_ROOT_PASSWORD=change-me-local-minio
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=local
OBJECT_STORAGE_BUCKET=orvex-isp-local
OBJECT_STORAGE_ACCESS_KEY_ID=orvex-local-admin
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me-local-minio

MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
MAIL_PROVIDER=mailpit
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECRET_REFERENCE=

# Secret/key references; production values resolve in the selected secret manager.
KMS_KEY_REFERENCE=local-development-only
SESSION_SECRET_REFERENCE=secret://local/session
# Local API bootstrap only. Production injects this from the reference above and rotates it.
JWT_SECRET=change-me-local-jwt-secret-at-least-32-characters
FIELD_ENCRYPTION_KEY_REFERENCE=secret://local/field-encryption
SUPPORT_TOKEN_ISSUER=orvex-isp-local
SUPPORT_TOKEN_AUDIENCE=orvex-isp-api-local

MIKROTIK_CONNECTOR_MODE=simulator
MIKROTIK_DEFAULT_TIMEOUT_MS=10000
MIKROTIK_CREDENTIAL_REFERENCE=
OMT_PROVIDER_MODE=manual
OMT_API_BASE_URL=
OMT_API_KEY_REFERENCE=
WHISH_PROVIDER_MODE=manual
WHISH_API_BASE_URL=
WHISH_API_KEY_REFERENCE=
PAYMENT_PROVIDER=manual
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY_REFERENCE=
PAYMENT_WEBHOOK_SECRET_REFERENCE=
MAPS_PROVIDER=disabled
MAPS_API_KEY_REFERENCE=
OTP_PROVIDER=disabled
OTP_SECRET_REFERENCE=

OBSERVABILITY_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAMESPACE=orvex-isp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# Backup variables are references/placeholders only; local Compose does not schedule backups.
BACKUP_BUCKET=
BACKUP_KMS_KEY_REFERENCE=
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=5
BACKUP_RETENTION_MONTHLY=12
