# Orvex ISP repository normalization contract.
#
# Release artifacts are byte-identical on every platform. Migration checksums are
# SHA-256 over raw migration bytes, and Alpine executes packaged shell scripts
# directly, so a CRLF checkout silently invalidates an applied migration ledger
# and breaks container entrypoints. Normalize text to LF in the index and on
# checkout, and keep binaries untouched.

* text=auto eol=lf

# Files whose exact bytes are part of a deployment or security contract.
*.sql   text eol=lf
*.sh    text eol=lf
*.mjs   text eol=lf
*.mts   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.xml   text eol=lf
*.conf  text eol=lf
*.cfg   text eol=lf
*.tf    text eol=lf
*.kt    text eol=lf
*.pro   text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.example text eol=lf
*.txt   text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.prettierignore text eol=lf
.dockerignore text eol=lf
.nvmrc  text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Windows-only helpers must keep CRLF to remain executable by cmd.exe.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets: never transformed, never diffed as text.
*.png      binary
*.webp     binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.jar      binary
*.keystore binary
*.zip      binary
*.gz       binary
*.tgz      binary
